{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidentloop-review/run.schema.json",
  "title": "EvidentLoop review output (model part)",
  "description": "Structural contract for what the model returns for one frozen review bundle: fields, types and enums only. Required fields must be present; reference arrays may be empty. All further checks and the host-side fields are defined by the plugin's single validation pipeline (design §4), not here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "inputSha",
    "promptVersion",
    "overview",
    "features",
    "files",
    "impacts",
    "alignment",
    "extras",
    "findings"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "inputSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "promptVersion": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "overview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "requirementStatus"
      ],
      "properties": {
        "purpose": {
          "$ref": "#/$defs/text"
        },
        "requirementStatus": {
          "enum": [
            "checked",
            "no-requirement"
          ]
        }
      }
    },
    "features": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "featureId",
          "title",
          "purpose",
          "approach",
          "files",
          "refs"
        ],
        "properties": {
          "featureId": {
            "type": "string",
            "pattern": "^F[0-9]+$"
          },
          "title": {
            "$ref": "#/$defs/text"
          },
          "purpose": {
            "$ref": "#/$defs/text"
          },
          "approach": {
            "$ref": "#/$defs/text"
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "refs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ref"
            }
          }
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "featureIds",
          "semantic"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "featureIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^F[0-9]+$"
            }
          },
          "semantic": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "items",
              "status"
            ],
            "properties": {
              "items": {
                "type": "array",
                "maxItems": 5,
                "items": {
                  "$ref": "#/$defs/statement"
                }
              },
              "status": {
                "enum": [
                  "stated",
                  "unclear"
                ]
              }
            }
          }
        }
      }
    },
    "impacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "text",
          "refs"
        ],
        "properties": {
          "kind": {
            "enum": [
              "api",
              "data",
              "config",
              "behavior",
              "dependency",
              "ui"
            ]
          },
          "text": {
            "$ref": "#/$defs/text"
          },
          "refs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ref"
            }
          }
        }
      }
    },
    "alignment": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirementItemId",
          "status",
          "codeRefs",
          "note"
        ],
        "properties": {
          "requirementItemId": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "implemented",
              "partial",
              "not-found",
              "unclear",
              "superseded"
            ]
          },
          "codeRefs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ref"
            }
          },
          "note": {
            "type": "string"
          },
          "supersededBy": {
            "type": "string",
            "minLength": 1
          },
          "supersededQuote": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "superseded"
                }
              }
            },
            "then": {
              "required": [
                "supersededBy",
                "supersededQuote"
              ],
              "properties": {
                "codeRefs": {
                  "maxItems": 0
                }
              }
            },
            "else": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "supersededBy"
                    ]
                  },
                  {
                    "required": [
                      "supersededQuote"
                    ]
                  }
                ]
              }
            }
          }
        ]
      }
    },
    "extras": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/statement"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category",
          "severity",
          "ruleSource",
          "title",
          "problem",
          "impact",
          "anchor",
          "evidence"
        ],
        "properties": {
          "category": {
            "enum": [
              "logic",
              "security",
              "performance"
            ]
          },
          "severity": {
            "enum": [
              "P0",
              "P1",
              "P2"
            ]
          },
          "ruleSource": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "id"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "builtin",
                  "project",
                  "user"
                ]
              },
              "id": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "title": {
            "$ref": "#/$defs/text"
          },
          "problem": {
            "$ref": "#/$defs/text"
          },
          "impact": {
            "$ref": "#/$defs/text"
          },
          "suggestion": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "$ref": "#/$defs/text"
              },
              "code": {
                "type": "string"
              }
            }
          },
          "anchor": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "side",
              "line"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "side": {
                "$ref": "#/$defs/side"
              },
              "line": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "side",
                "startLine",
                "endLine",
                "quote"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "side": {
                  "$ref": "#/$defs/side"
                },
                "startLine": {
                  "type": "integer",
                  "minimum": 1
                },
                "endLine": {
                  "type": "integer",
                  "minimum": 1
                },
                "quote": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "side": {
      "enum": [
        "base",
        "head"
      ]
    },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "side",
        "startLine",
        "endLine"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "side": {
          "$ref": "#/$defs/side"
        },
        "startLine": {
          "type": "integer",
          "minimum": 1
        },
        "endLine": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "refs"
      ],
      "properties": {
        "text": {
          "$ref": "#/$defs/text"
        },
        "refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ref"
          }
        }
      }
    }
  }
}
