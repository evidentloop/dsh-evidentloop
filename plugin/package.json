{
  "name": "dsh-evidentloop",
  "version": "0.1.0-rc.1",
  "type": "module",
  "description": "AI 写完代码，先看懂改了什么、有没有问题：变更说明、带证据的代码评审、发回修改与审查留档。",
  "files": [
    "dist/host.mjs",
    "dist/client.js",
    "dist/client.css",
    "skills",
    "vendor",
    "cordis.patch.yml",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "locale",
    "icon.svg"
  ],
  "exports": {
    ".": "./dist/host.mjs",
    "./client": "./dist/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "compatibility": "^0.2.2-rc.2",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "scripts": {
    "build": "npm run typecheck && node scripts/build.mjs",
    "test": "node --import tsx tests/run.mjs",
    "typecheck": "node scripts/schema-types.mjs --check && tsc --noEmit -p ../tsconfig.json",
    "test:ui": "node --import tsx tests/browser-headless.mjs"
  },
  "author": "sanze.li",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "code-review",
    "evidentloop"
  ],
  "engines": {
    "node": ">=20",
    "dsh": "^0.2.2-rc.2"
  },
  "icon": "./icon.svg",
  "homepage": "https://evidentloop.sanze.dev",
  "publishConfig": {
    "tag": "beta",
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evidentloop/dsh-evidentloop.git",
    "directory": "plugin"
  }
}
